<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RezervisiMe.Worker</RootNamespace>
    <UserSecretsId>rezervisime-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ucitavanje .env (isti pristup kao glavni API - konfiguracija na jednom mjestu). -->
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <!-- Slusanje RabbitMQ reda poruka. -->
    <PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
    <!-- Slanje emaila preko SMTP-a. -->
    <PackageReference Include="MailKit" Version="4.8.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

</Project>
