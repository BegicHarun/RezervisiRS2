# ==========================================================
# RezervisiMe - .env (konfiguracija, upute 3.3)
# NE ide u Git ni u GitHub Release. Za predaju: .env-tajne.zip (sifra "fit").
# ==========================================================

# ---- SQL baza ----
# SQL Server 2022 radi na x64 (native) i Apple Silicon (emulacija).
SQL_IMAGE=mcr.microsoft.com/mssql/server:2022-CU14-ubuntu-22.04
SQL_PLATFORM=linux/amd64

# ---- JWT ----
JWT_KEY=promijeni-ovo-u-dugacak-nasumican-kljuc-od-najmanje-32-karaktera
JWT_ISSUER=RezervisiMe
JWT_AUDIENCE=RezervisiMeClients
JWT_EXPIRY_MINUTES=120

# ---- RabbitMQ ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---- PayPal (sandbox) ----
PAYPAL_CLIENT_ID=ovdje-tvoj-sandbox-client-id
PAYPAL_SECRET=ovdje-tvoj-sandbox-secret
PAYPAL_MODE=sandbox
PAYPAL_RETURN_BASE=https://example.com

# ---- SMTP ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@rezervisime.ba
SMTP_PASSWORD=promijeni-me
SMTP_USE_SSL=true
